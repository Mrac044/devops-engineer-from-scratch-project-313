http://:{$PORT} {
    log {
        format json
    }

    # ИСПРАВЛЕНИЕ: Указываем чистый и гарантированно существующий путь к фронтенду
    root * /app/dist

    # Перенаправляем запросы на Flask, запущенный локально внутри контейнера
    handle /api* {
        reverse_proxy 127.0.0.1:5000
    }

    handle /r* {
        reverse_proxy 127.0.0.1:5000
    }

    # Раздаем фронтенд
    handle {
        try_files {path} {path}/ /index.html
        file_server
    }
}